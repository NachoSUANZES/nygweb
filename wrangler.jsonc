{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyg-investment",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "nyginvest.com", "custom_domain": true },
    { "pattern": "www.nyginvest.com", "custom_domain": true }
  ]
}
